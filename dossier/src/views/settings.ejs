<%- include("_header", { user, title: "Settings" }) %>
<section class="card">
    <h1>Profile</h1>
    <p class="muted">Update how your name appears across Dossier.</p>
    <% if (saved) { %>
        <div class="success">Saved.</div>
    <% } %>
    <dl class="meta">
        <dt>Email</dt><dd><%= user.email %></dd>
        <dt>Organization</dt><dd><%= user.org_name %></dd>
    </dl>
    <form id="profile-form">
        <label>Name<input id="name" name="name" value="<%= user.name %>" required /></label>
        <button type="submit">Save</button>
    </form>
    <script>
        document.getElementById("profile-form").addEventListener("submit", async (e) => {
            e.preventDefault();
            const name = document.getElementById("name").value;
            const res = await fetch("/api/users/me", {
                method: "PATCH",
                headers: { "content-type": "application/json" },
                body: JSON.stringify({ name }),
            });
            if (res.ok) {
                window.location = "/settings?saved=1";
            } else {
                const j = await res.json().catch(() => ({}));
                alert(j.error || "Save failed");
            }
        });
    </script>
</section>
<%- include("_footer") %>
